<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository-level NuGet configuration.

  <clear /> discards any inherited sources from machine/user-level config so a
  broken or unwanted feed (e.g. a re-added Xenko/Stride source) can never break
  `dotnet restore` here. This project resolves packages from nuget.org only,
  making restore reproducible on any machine.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
